# Optional. Without a key the chat uses the built-in rule-based parser and everything still works.
# One key, or several for rotation and failover (comma, space or new line separated). Never commit real keys.
GEMINI_API_KEYS=
# Older single-key name, still read.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash (unverified; set the model your key can use).
GEMINI_MODEL=
